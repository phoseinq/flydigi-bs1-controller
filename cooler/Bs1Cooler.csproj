<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <NoWarn>WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Bs1Cooler</AssemblyName>
    <Version>1.0.0</Version>
    <Product>BS1 Cooler</Product>
    <RootNamespace>Bs1Cooler</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>cooler.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 0.9.4 = same version Space Station ships; its WinRing0 driver is known to load on this machine -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="cooler.ico" />
  </ItemGroup>
</Project>
