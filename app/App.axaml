<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Bs1Cooler.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- Fluent 2 (WinUI) look; follows the Windows light/dark theme and accent color -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <!-- light color swatches: a ring marks the chosen one -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch.chosen">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- home -->
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.stat ic|SymbolIcon"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,0,-2" />
    </Style>
    <!-- Smart | Manual: one pill, the chosen half filled with the accent -->
    <Style Selector="Border.seg">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.seg ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <!-- settings: grouped sections with a colored tile, rows with small icons -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="StackPanel.sechead">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="StackPanel.sechead > TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.tile > ic|SymbolIcon">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- translucent tint + saturated glyph: readable in both light and dark -->
    <Style Selector="Border.tile.blue"><Setter Property="Background" Value="#332F7FED" /></Style>
    <Style Selector="Border.tile.blue > ic|SymbolIcon"><Setter Property="Foreground" Value="#3D8BF2" /></Style>
    <Style Selector="Border.tile.green"><Setter Property="Background" Value="#3322A35A" /></Style>
    <Style Selector="Border.tile.green > ic|SymbolIcon"><Setter Property="Foreground" Value="#2DB467" /></Style>
    <Style Selector="Border.tile.purple"><Setter Property="Background" Value="#338A5CF6" /></Style>
    <Style Selector="Border.tile.purple > ic|SymbolIcon"><Setter Property="Foreground" Value="#9B74F7" /></Style>
    <Style Selector="Border.tile.orange"><Setter Property="Background" Value="#33F08A24" /></Style>
    <Style Selector="Border.tile.teal"><Setter Property="Background" Value="#3314B8A6" /></Style>
    <Style Selector="Border.tile.teal > ic|SymbolIcon"><Setter Property="Foreground" Value="#14B8A6" /></Style>
    <Style Selector="Border.tile.orange > ic|SymbolIcon"><Setter Property="Foreground" Value="#F0922F" /></Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style Selector="Grid.row > ic|SymbolIcon">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Grid.row > StackPanel, Grid.row > ToggleSwitch, Grid.row > ComboBox, Grid.row > Button">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.row ToggleSwitch">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="TextBlock.desc">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.section Separator">
      <Setter Property="Margin" Value="30,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <!-- update-mode tutorial: numbered steps and the animated cooler -->
    <Style Selector="Border.dot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.25" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dot > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.dot.active">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.dot.active > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.dot.done">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="Border.dot.done > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <!-- step 1: the cable slides out -->
    <Style Selector="Grid.unplug StackPanel.cable">
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="Infinite" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Margin" Value="224,70,0,0" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="Margin" Value="224,70,0,0" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Margin" Value="272,70,0,0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Margin" Value="272,70,0,0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- steps 2-3: the button pulses while the cable goes back in -->
    <Style Selector="Grid.plug StackPanel.cable">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Margin" Value="272,70,0,0" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Margin" Value="272,70,0,0" /></KeyFrame>
          <KeyFrame Cue="75%"><Setter Property="Margin" Value="224,70,0,0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Margin" Value="224,70,0,0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Grid.plug Ellipse.ring">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.9" /><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Margin" Value="178,26,0,0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="Width" Value="56" /><Setter Property="Height" Value="56" /><Setter Property="Margin" Value="162,10,0,0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>
</Application>
