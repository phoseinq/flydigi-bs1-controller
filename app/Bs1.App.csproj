<Project Sdk="Microsoft.NET.Sdk">
  <!-- BS1 Cooler: Avalonia UI (Fluent 2 look) over core\ (protocol, fan and light logic). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the -windows build gets WinRT Bluetooth and media sessions; plain net10.0 is Linux and macOS -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>  <!-- restore on Linux/macOS CI sees the -windows target too -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Bs1Cooler.App</RootNamespace>
    <AssemblyName>Bs1Cooler</AssemblyName>
    <ApplicationManifest Condition="'$(TargetFramework)' != 'net10.0'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cooler.ico</ApplicationIcon>
    <Version>2.0.7</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Linux.Bluetooth" Version="5.67.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\Bs1.Core.csproj" />
    <Compile Remove="Platform\Win*.cs;Platform\Temps.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Remove="Platform\Linux\**;Platform\Mac\**" Condition="'$(TargetFramework)' != 'net10.0'" />
    <AvaloniaResource Include="Assets\cooler.ico" />
    <!-- sealed images (FirmwareBox); made from the plain .bin files by running the app with the seal-firmware flag -->
    <EmbeddedResource Include="..\firmware\official.bin.sealed" LogicalName="official.bin" WithCulture="false" />
    <EmbeddedResource Include="..\firmware\custom.bin.sealed" LogicalName="custom.bin" WithCulture="false" />
    <None Include="Assets\cooler.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="cooler.ico" Condition="'$(TargetFramework)' == 'net10.0'" />  <!-- icon for the Linux menu entry -->
    <None Include="Platform\Linux\99-bs1cooler.rules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="99-bs1cooler.rules" Condition="'$(TargetFramework)' == 'net10.0'" />
    <None Include="Platform\CH375DLL64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="CH375DLL64.dll" Condition="'$(TargetFramework)' != 'net10.0'" />
    <!-- WCH's signed USB driver package for the bootloader, installed with pnputil when missing -->
    <None Update="Platform\ch375driver\*" Condition="'$(TargetFramework)' != 'net10.0'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="ch375driver\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- symbols are 100 MB of the publish output (SkiaSharp, HarfBuzz): not for users -->
  <Target Name="DropPdbs" AfterTargets="Publish">
    <ItemGroup><PublishedPdbs Include="$(PublishDir)*.pdb" /></ItemGroup>
    <Delete Files="@(PublishedPdbs)" />
  </Target>
</Project>
